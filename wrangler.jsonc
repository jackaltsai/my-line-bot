{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-line-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": [
			// 每天 01:00 UTC（台灣時間 09:00）推播每日問候給付費方案使用者
			"0 1 * * *",
			// 每 5 分鐘同步一次 LINE Pay 待確認訂單（導回 confirmUrl 不可靠，靠這個排程主動確認付款）
			"*/5 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		},
		{
			"binding": "my_line_bot_db",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		}
	],
	"vars": {
		// LINE Pay 環境："sandbox"（測試）或 "production"（正式，通過商家審核後改這個）
		"LINE_PAY_ENV": "sandbox",
		// 部署後的 Worker 網址，用來組出 LINE Pay confirmUrl/cancelUrl
		"APP_BASE_URL": "https://my-line-bot.hata-s520.workers.dev"
	}
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
}