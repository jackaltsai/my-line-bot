{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-line-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		// 每天 01:00 UTC（台灣時間 09:00）推播每日問候給付費方案使用者
		"crons": [
			"0 1 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		},
		{
			"binding": "my_line_bot_db",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		}
	],
	// OEN（應援科技）金流串接所需環境變數：
	// - vars（非機密，直接填在這裡）：
	//     OEN_API_BASE_URL      https://payment-api.testing.oen.tw（測試）
	//                            正式上線前換成 https://payment-api.oen.tw
	//     OEN_CHECKOUT_BASE_URL https://{merchantId}.testing.oen.tw（測試，結帳頁網域）
	//                            正式上線前換成 https://{merchantId}.oen.tw
	//     OEN_MERCHANT_ID       測試環境為 hata
	//     OEN_SUCCESS_URL       付款成功導回 LINE 對話
	//     OEN_FAILURE_URL       付款失敗導回 LINE 對話
	// - secrets（機密，用 `wrangler secret put <NAME>` 設定，不要寫進這個檔案）：
	//     OEN_API_TOKEN 應援 CRM 後台 - 總設定 - 開發者選項 產出的 Bearer token
	//                   測試環境的 token 只能在測試環境用，正式環境要另外產一組
	//                   同一頁記得把「交易回傳位置」設定成 /webhook/oen 的完整網址
	"vars": {
		"OEN_API_BASE_URL": "https://payment-api.testing.oen.tw",
		"OEN_CHECKOUT_BASE_URL": "https://hata.testing.oen.tw",
		"OEN_MERCHANT_ID": "hata",
		"OEN_SUCCESS_URL": "https://line.me/R/ti/p/@heartchen",
		"OEN_FAILURE_URL": "https://line.me/R/ti/p/@heartchen"
	},
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
}