{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-line-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		// 每天 01:00 UTC（台灣時間 09:00）推播每日問候給付費方案使用者
		"crons": [
			"0 1 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		},
		{
			"binding": "my_line_bot_db",
			"database_name": "my-line-bot-db",
			"database_id": "804c53b2-3aea-4222-9ee5-77da7c217cc6"
		}
	]
	// Stripe 金流串接所需環境變數：
	// - vars（非機密，可直接填在這裡或用 wrangler.jsonc 的 vars）：
	//     STRIPE_PRICE_ID    付費方案對應的 Stripe Price ID
	//     STRIPE_SUCCESS_URL 付款成功導向頁面
	//     STRIPE_CANCEL_URL  付款取消導向頁面
	// - secrets（機密，用 `wrangler secret put <NAME>` 設定，不要寫進這個檔案）：
	//     STRIPE_SECRET_KEY     Stripe API 密鑰（sk_live_... / sk_test_...）
	//     STRIPE_WEBHOOK_SECRET Stripe webhook 簽章密鑰（whsec_...），
	//                            對應 Stripe Dashboard 設定的 endpoint：/webhook/stripe
	// "vars": {
	//   "STRIPE_PRICE_ID": "price_xxxxxxxxxxxxx",
	//   "STRIPE_SUCCESS_URL": "https://line.me/R/ti/p/@your-bot-id",
	//   "STRIPE_CANCEL_URL": "https://line.me/R/ti/p/@your-bot-id"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
}